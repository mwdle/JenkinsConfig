[Unit]
Requires=pinp.service
After=pinp.service

[Container]
Image=jenkins.build
Pull=never
ContainerName=jenkins

Network=jenkins.network
# TODO: remove this local test port once a reverse proxy provides access to Jenkins.
PublishPort=127.0.0.1:8080:8080

Secret=jenkins_admin_username,target=admin_username,uid=1000,gid=1000,mode=0400
Secret=jenkins_admin_password,target=admin_password,uid=1000,gid=1000,mode=0400
Secret=jenkins_git_username,target=git_username,uid=1000,gid=1000,mode=0400
Secret=jenkins_git_token,target=git_token,uid=1000,gid=1000,mode=0400
Secret=jenkins_smtp_username,target=smtp_username,uid=1000,gid=1000,mode=0400
Secret=jenkins_smtp_password,target=smtp_password,uid=1000,gid=1000,mode=0400
Secret=jenkins_alert_email,target=alert_email,uid=1000,gid=1000,mode=0400

Environment=CASC_JENKINS_CONFIG=/var/jenkins_home/jcasc
Environment=DOCKER_HOST=unix:///run/podman/podman.sock
Environment=JAVA_OPTS=-Djenkins.install.runSetupWizard=false
Environment=TZ=America/Denver

Volume=pinp-socket.volume:/run/podman:ro,z
Volume=%h/containers/jenkins:/var/jenkins_home:U,Z
Volume=./jcasc:/var/jenkins_home/jcasc:ro,Z

ReadOnly=true
ReadOnlyTmpfs=false
Tmpfs=/tmp

UserNS=auto
NoNewPrivileges=true
DropCapability=all
SecurityLabelType=container_engine_t

HealthStartupCmd=curl -fSs -o /dev/null http://localhost:8080/health || exit 1
HealthStartupInterval=5s
HealthStartupTimeout=5s
HealthCmd=curl -fSs -o /dev/null http://localhost:8080/health || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthOnFailure=kill
Notify=healthy

Memory=2G
PidsLimit=1024

[Service]
CPUQuota=300%
Restart=always
RestartSec=5s
ExecStartPre=mkdir -p -m 0700 %h/containers/jenkins

[Install]
WantedBy=default.target
